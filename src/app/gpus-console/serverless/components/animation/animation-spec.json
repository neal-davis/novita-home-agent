{
  "_note": "Animation Specification — Serverless Ready Card. Transparent background for embedding.",
  "animation_specs": {
    "global_settings": {
      "fps": 60,
      "trigger": "onLoad",
      "background": "transparent",
      "canvas": {
        "width": 500,
        "height": 500
      }
    },
    "elements": {
      "background_square_back": {
        "description": "Back layer — lightest gray rounded square, slow rotation",
        "size": { "width": 280, "height": 280 },
        "borderRadius": 36,
        "fillColor": "#e8e9ed",
        "keyframes": {
          "rotate": [-6, -366]
        },
        "duration": 25,
        "easing": "linear",
        "loop": "infinite"
      },
      "background_square_mid": {
        "description": "Middle layer — slightly darker gray rounded square, counter-rotation",
        "size": { "width": 280, "height": 280 },
        "borderRadius": 36,
        "fillColor": "#dfe0e5",
        "keyframes": {
          "rotate": [6, 366]
        },
        "duration": 30,
        "easing": "linear",
        "loop": "infinite"
      },
      "main_card": {
        "description": "Front layer — white rounded square card",
        "size": { "width": 280, "height": 280 },
        "borderRadius": 36,
        "fillColor": "#ffffff",
        "boxShadow": "0 12px 40px rgba(0,0,0,0.07), 0 2px 8px rgba(0,0,0,0.04)",
        "idle_animation": {
          "keyframes": {
            "y": [0, -10, 0]
          },
          "duration": 6,
          "easing": "easeInOut",
          "loop": "infinite"
        },
        "interaction": {
          "hover": { "scale": 1.02 },
          "tap": { "scale": 0.98 }
        }
      },
      "center_chip_graphic": {
        "description": "CPU chip icon — 3x3 rounded-square grid with pins on all four sides",
        "size": { "width": 120, "height": 120 },
        "chip_body": {
          "rect": { "x": 22, "y": 22, "width": 76, "height": 76, "rx": 10 },
          "stroke": "#a0a4ae",
          "strokeWidth": 2.5,
          "fill": "#f4f5f7"
        },
        "grid_cells": {
          "size": { "width": 18, "height": 18, "rx": 4 },
          "fill": "#c8cad0",
          "layout": "3x3",
          "gap": 3,
          "center_cell": "empty (green light overlay)"
        },
        "pins": {
          "count_per_side": 3,
          "stroke": "#b0b3bb",
          "strokeWidth": 2,
          "length": 14,
          "linecap": "round"
        },
        "intro_animation": {
          "keyframes": {
            "scale": [0.8, 1],
            "opacity": [0, 1]
          },
          "duration": 0.8,
          "delay": 0.2,
          "easing": "easeOut"
        }
      },
      "chip_green_light": {
        "description": "Green pulsing dot at center of chip grid",
        "size": { "width": 14, "height": 14 },
        "fillColor": "#4aba82",
        "borderRadius": "50%",
        "position": "center of chip grid",
        "pulse_animation": {
          "keyframes": {
            "scale": [1, 1.25, 1],
            "opacity": [0.72, 1, 0.72]
          },
          "duration": 2,
          "easing": "easeInOut",
          "loop": "infinite"
        }
      },
      "bottom_dots": {
        "description": "Three indicator dots below chip: gray, green, gray",
        "layout": "horizontal",
        "gap": 8,
        "dots": [
          { "size": 10, "fillColor": "#c0c3ca" },
          { "size": 10, "fillColor": "#4aba82", "animated": true },
          { "size": 10, "fillColor": "#c0c3ca" }
        ],
        "green_dot_animation": {
          "keyframes": {
            "scale": [0.9, 1.1, 0.9],
            "opacity": [0.6, 1, 0.6]
          },
          "duration": 1.5,
          "delay": 0.5,
          "easing": "easeInOut",
          "loop": "infinite"
        }
      },
      "status_text_group": {
        "description": "SERVERLESS READY label + 99.9% percentage",
        "intro_animation": {
          "keyframes": {
            "y": [15, 0],
            "opacity": [0, 1]
          },
          "duration": 0.8,
          "delay": 0.6,
          "easing": "easeOut"
        },
        "label": {
          "content": "SERVERLESS READY",
          "fontSize": 13,
          "fontWeight": 700,
          "color": "#6b7080",
          "letterSpacing": 2.5,
          "textTransform": "uppercase"
        },
        "percentage": {
          "content": "99.9%",
          "fontSize": 36,
          "fontWeight": 800,
          "color": "#6b7080"
        }
      },
      "percentage_counter": {
        "description": "Number counter animation from 0.0% to 99.9%",
        "counter_animation": {
          "from": 0,
          "to": 99.9,
          "duration": 2.5,
          "delay": 0.5,
          "easing": "easeOut",
          "format": "toFixed(1) + '%'"
        }
      }
    }
  }
}
