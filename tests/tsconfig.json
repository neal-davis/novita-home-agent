{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "moduleDetection": "force",
    "noEmit": true,
    "strict": false,
    "types": ["jest", "@testing-library/jest-dom", "node"]
  },
  "include": [
    "../jest.setup.js",
    "../jest.config.js",
    "../next-env.d.ts",
    "../src/**/*.ts",
    "../src/**/*.tsx",
    "./unit/**/*.ts",
    "./unit/**/*.tsx"
  ],
  "exclude": ["../node_modules", "../e2e_tests"]
}
