{
  "name": "aigc-home",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:prod": "cross-env NEXT_PUBLIC_BASE_URL=https://api-server.novita.ai NEXT_PUBLIC_API_URL=https://api.novita.ai MODEL_API_URL=https://api.novita.ai NEXT_PUBLIC_ENV=prod NEXT_PUBLIC_LANG=en next dev",
    "mock": "cross-env NEXT_PUBLIC_BASE_URL=https://dev-api-server.novita.ai NEXT_PUBLIC_API_URL=https://dev-api.novita.ai NEXT_PUBLIC_ENV=dev  NEXT_PUBLIC_LANG=en MOCK=1 next dev",
    "en": "cross-env NEXT_PUBLIC_BASE_URL=https://dev-api-server.novita.ai NEXT_PUBLIC_API_URL=https://dev-api.novita.ai NEXT_PUBLIC_ENV=dev  NEXT_PUBLIC_LANG=en next dev",
    "dev": "node scripts/watcher/resourceCopy en test && node scripts/check-forbidden-keywords.js && npm run en",
    "build": "node ./scripts/sitemap-generate && node scripts/watcher/resourceCopy en && node scripts/check-forbidden-keywords.js && cross-env NEXT_PUBLIC_BASE_URL=https://api-server.novita.ai NEXT_PUBLIC_API_URL=https://api.novita.ai NEXT_PUBLIC_ENV=prod NEXT_PUBLIC_LANG=en next build",
    "build:zh": "node scripts/watcher/resourceCopy en && node scripts/check-forbidden-keywords.js && cross-env NEXT_PUBLIC_BASE_URL=https://api-server.novita.ai NEXT_PUBLIC_API_URL=https://api.novita.ai NEXT_PUBLIC_ENV=prod NEXT_PUBLIC_LANG=zh-CN next build",
    "build:test": "node scripts/watcher/resourceCopy en test && node scripts/check-forbidden-keywords.js && cross-env NEXT_PUBLIC_BASE_URL=https://dev-api-server.novita.ai NEXT_PUBLIC_API_URL=https://dev-api.novita.ai NEXT_PUBLIC_ENV=test NEXT_PUBLIC_LANG=en next build",
    "build:analyze": "node scripts/watcher/resourceCopy en && node scripts/check-forbidden-keywords.js && cross-env ANALYZE=true NEXT_PUBLIC_BASE_URL=https://api-server.novita.ai NEXT_PUBLIC_API_URL=https://api.novita.ai NEXT_PUBLIC_ENV=prod NEXT_PUBLIC_LANG=en next build",
    "lint": "oxlint .",
    "lint:ci": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "check:file-line-limit": "node scripts/check-file-limit.js --staged",
    "prettier": "prettier --write .",
    "i18n": "node scripts/i18n/index.js",
    "i18n:scan": "node scripts/i18n/index.js scan",
    "i18n:scan:full": "node scripts/i18n/index.js scan --full",
    "i18n:report": "node scripts/i18n/index.js report",
    "i18n:compile": "node scripts/i18n/index.js compile",
    "i18n:compile:all": "node scripts/i18n/index.js compile --all",
    "i18n:translate": "node scripts/i18n/index.js translate",
    "i18n:translate:all": "node scripts/i18n/index.js translate --all",
    "i18n:lint": "node scripts/i18n/index.js lint",
    "i18n:lint:update-baseline": "node scripts/i18n/index.js lint --update-baseline",
    "i18n:check": "node scripts/i18n/index.js check",
    "i18n:check-frozen": "node scripts/i18n/check-frozen-module-scope.js",
    "i18n:check-frozen:update-allowlist": "node scripts/i18n/check-frozen-module-scope.js --update-allowlist",
    "predev": "npm run i18n:scan && npm run i18n:compile",
    "prebuild": "npm run i18n:lint && npm run i18n:check-frozen && npm run i18n:scan && npm run i18n:compile",
    "prebuild:zh": "npm run i18n:lint && npm run i18n:scan && npm run i18n:compile",
    "prepare": "husky install",
    "git:clean": "node ./scripts/git-branch-clean",
    "gen-sitemap": "node ./scripts/sitemap-generate/index",
    "start": "node scripts/prepare-standalone.js && node .next/standalone/server.js",
    "start:next": "next start",
    "start:standalone": "node scripts/prepare-standalone.js && node .next/standalone/server.js",
    "test:unit": "cross-env NODE_ENV=test jest",
    "test:unit:coverage": "cross-env NODE_ENV=test jest --coverage",
    "test:unit:coverage:ci": "cross-env NODE_ENV=test jest --coverage --silent",
    "test:location": "node scripts/check-test-location.js",
    "test:e2e": "playwright test && playwright show-report",
    "test:e2e:agent": "playwright test",
    "test:e2e:smoke": "playwright test --config=playwright.smoke.config.ts --pass-with-no-tests",
    "test:e2e:demo": "cross-env DEMO=1 playwright test --config=playwright.demo.config.ts",
    "route:catalog": "node scripts/agent/route-catalog.mjs",
    "test:e2e:sweep": "node scripts/agent/route-catalog.mjs --out e2e_tests/route-catalog.generated.json && playwright test --config=playwright.sweep.config.ts",
    "e2e:coverage": "node scripts/agent/route-catalog.mjs --out e2e_tests/route-catalog.generated.json && node scripts/agent/e2e-coverage.mjs",
    "check:dev-server": "node scripts/agent/check-dev-server.mjs",
    "check:fixtures": "node scripts/agent/check-fixtures.mjs",
    "check:report": "node scripts/agent/check-report.mjs",
    "diff:routes": "node scripts/agent/diff-routes.mjs",
    "pre-build-check": "node scripts/check-forbidden-keywords.js && npm run test:location && npm run lint:ci && npm run i18n:lint && npm run test:unit:coverage:ci && tsc --noEmit",
    "doctor": "npx react-doctor@latest"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,scss,md}": "prettier --write",
    "*.{js,jsx,ts,tsx}": "oxlint --fix",
    "*.{ts,tsx}": "npm run i18n:lint -- --files"
  },
